# Copy to .env and fill in. docker-compose passes this file to every service.

# Postgres
POSTGRES_DB=workzoradb
POSTGRES_USER=workzorauser
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# RabbitMQ and Redis
RABBITMQ_URL=amqp://rabbitmq:5672
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PORT_PUBLIC=6379

# API gateway: PORT inside the container, API_PORT on the host
PORT=8000
API_PORT=8000
ADMIN_PORT=3001

# Auth
JWT_SECRET=
GOOGLE_CLIENT_ID=

# Email (SendPulse)
SENDPULSE_CLIENTID=
SENDPULSE_SECRET=
SENDPULSE_API_KEY=
SMTP_USER=
TOKEN_STORAGE=/tmp/

# Links in emails and payment redirects
FRONTEND_URL=https://workzora.com
# Public site that serves /images/email/*; keep it public even on a local setup
EMAIL_ASSETS_URL=https://workzora.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments
MONO_API=
MONO_WEBHOOK_URL=
CARD_ENCRYPTION_KEY=
